{
 "constraints": {
  "ceilings": {
   "note": "transport_retries covers transport failures only. A guard failure is never a retry \u2014 it is a loop iteration, and it must change the input to count.\nper_methodology_layer is bytes of foundations/ per layer, and it is a ceiling on every prompt of every run that resolves through that layer \u2014 the firm layer being every run there is. 64 KiB is roughly sixteen thousand tokens: room for a practice group to say how it works, and not room for a document nobody meant to send with every call. Raising it is a decision about what the firm pays per run.",
   "per_methodology_layer": {
    "bytes_max": 65536
   },
   "per_run": {
    "loop_iterations_max": 8,
    "tokens_max": 3000000,
    "usd_max": 40.0,
    "wall_clock_s": 5400
   },
   "per_step": {
    "timeout_s": 300,
    "transport_retries_max": 2,
    "usd_max": 6.0
   }
  },
  "loops": {
   "conflict_resolution": {
    "max_iterations": 1,
    "scope": "in_run"
   },
   "drift_re_review": {
    "max_iterations": null,
    "scope": "cross_run"
   },
   "guard_repair": {
    "max_iterations": 2,
    "scope": "in_run"
   },
   "human_clarification": {
    "max_iterations": 1,
    "scope": "run_spanning"
   },
   "self_verification": {
    "max_iterations": 1,
    "scope": "in_run"
   },
   "tieout_repair": {
    "max_iterations": 1,
    "scope": "in_run"
   }
  },
  "tools": {
   "chart_of_accounts_lookup": {
    "caps": {
     "max_rows": 5000,
     "pinned_version_required": true
    },
    "kind": "reads",
    "read_only": true
   },
   "index_lookup": {
    "caps": {
     "freshness_days": 400,
     "max_rows": 500
    },
    "kind": "reads",
    "read_only": true
   },
   "precedent_lookup": {
    "caps": {
     "max_rows": 200,
     "scope_required": true
    },
    "kind": "reads",
    "read_only": true
   },
   "recompute": {
    "caps": {
     "max_calls_per_step": 200,
     "max_rows": 50000
    },
    "kind": "computes",
    "read_only": false
   },
   "template_schema_lookup": {
    "caps": {
     "max_rows": 2000
    },
    "kind": "reads",
    "read_only": true
   },
   "timing_normalizer": {
    "caps": {
     "max_calls_per_step": 20,
     "max_periods": 40,
     "max_rows": 50000
    },
    "kind": "computes",
    "read_only": false
   }
  },
  "version": "1.0.0"
 },
