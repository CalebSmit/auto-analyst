# Copy to .env and fill in. .env is gitignored and never leaves this machine.
# At handoff to the work machine, only ANTHROPIC_API_KEY changes.

ANTHROPIC_API_KEY=sk-ant-...

# Deployment mode: local | work | cloud
AA_MODE=local

# Ports - local adapters for phases 1-24
AA_STORAGE_ADAPTER=local_folder
AA_DELIVERY_ADAPTER=local_folder
AA_SECRETS_ADAPTER=dotenv
AA_QUEUE_ADAPTER=in_process
AA_LLM_ADAPTER=anthropic_messages

# State store. SQLite locally; the same conformance suite runs against Postgres.
AA_DB_URL=sqlite:///./aa.db

# Intake and delivery roots (local mode only)
AA_INBOX_ROOT=./inbox
AA_OUTBOX_ROOT=./outbox
