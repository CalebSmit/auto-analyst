# Copy to .env and fill in. .env is gitignored and never leaves this machine.
# At handoff to the work machine two things change: ANTHROPIC_API_KEY, and
# AA_OCR_ADAPTER=tesseract, because every PDF the clients send is a scan and the
# default engine here reads none of them. See HANDOFF.md.

ANTHROPIC_API_KEY=sk-ant-...

# `python tools/serve.py` reads this file into its environment at startup, so every setting
# here takes effect without exporting it; a variable already set in the real environment
# wins. The rehearsal sets AA_NO_ENV_FILE=1 so a developer's .env stays out of it.
# AA_NO_ENV_FILE=

# Deployment mode: local | work | cloud
AA_MODE=local

# Ports - local adapters for phases 1-24
AA_STORAGE_ADAPTER=local_folder
AA_DELIVERY_ADAPTER=local_folder
AA_SECRETS_ADAPTER=dotenv
AA_QUEUE_ADAPTER=in_process
AA_COMPUTE_ADAPTER=local_process
AA_IDENTITY_ADAPTER=local_user

# Which engine reads a scanned page. `none` is the default and is honest rather than
# degraded: it refuses, and the reader goes on reporting a scan rather than reading it as
# an empty page. Every PDF this firm receives is a scan, so on a machine that does the real
# work this wants to be `tesseract` - which needs the Tesseract executable on PATH, plus
# `pypdfium2` and `pytesseract`.
#
# It has to be local. Masking needs text, text from a scan needs OCR, and OCR by a vision
# model would put the unmasked client document in front of a model before masking could
# happen - which is the one ordering nothing downstream can recover from.
AA_OCR_ADAPTER=none

# Who a change is recorded against. The local-user adapter answers with the operating
# system user and refuses any request that did not come from this machine, so binding the
# surface to a network address needs an adapter that authenticates - see P36. Set a name
# here when the OS answer is not one the firm would recognise, which is the usual case in
# a container running as `analyst`.
# AA_IDENTITY_NAME=

# The fake LLM adapter replays recorded fixtures, so phases 4-10 need no API key and
# cost nothing to run. Switch to anthropic_messages when a run means to reach a model.
AA_LLM_ADAPTER=fake

# State store. The run store is a repository behind this one URL: SQLite locally
# through P24, Postgres after, with no other change. runs/ is gitignored - the record
# holds client data. This is also the default when nothing is set.
AA_DB_URL=sqlite:///./runs/run_store.db

# Where `pytest --postgres` looks for a server, when there is one. Nothing else reads
# it, and the suite is red rather than skipped if --postgres is asked for and no server
# answers.
# AA_TEST_PG_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analyst_test

# The mask vault's encryption key. The vault is the only store that can re-identify
# anything, and this key is the only thing that opens it. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and never commit it. Losing it loses every token it protects.
AA_VAULT_KEY=
# Retention for vault entries, in days. A placeholder: setting the policy is Risk / IT's
# decision in the blueprint, before phase 1.
# AA_VAULT_RETENTION_DAYS=730

# Intake and delivery roots (local mode only)
AA_INBOX_ROOT=./inbox
AA_OUTBOX_ROOT=./outbox

# Compute target (optional). Parallelism is cross-engagement - the Engagement Lock
# already serialises within one deal, and the worker pool asks this port how wide it may
# be rather than assuming.
# AA_MAX_PARALLELISM=1
# AA_IMAGE=automated-analyst:0.1.0
# Scratch space for a run. Never inside the repo: run artifacts hold client data.
# Defaults to the system temp directory.
# AA_WORKDIR=

# The job queue. in_process runs a bounded thread pool in this process; redis_rq runs
# over a broker, for when runs outlive the process that submitted them.
# AA_REDIS_URL=redis://localhost:6379/0
# AA_REDIS_QUEUE=automated-analyst
# Where `pytest --redis` looks for a real server. Without it the queue suite runs the
# adapter over an in-memory fake and says so in the session summary.
# AA_TEST_REDIS_URL=redis://localhost:6379/15

# The governance chain's working root: the drop folder, triage, the sandbox and the
# append-only governance record. Outside the repo, always - a dropped draft is untrusted
# content and the scan that catches a pasted trial balance runs after the drop.
# Defaults to ~/.automated-analyst/skills-intake
# AA_SKILLS_INTAKE_ROOT=

# Where tools/postgres.py keeps the portable PostgreSQL binaries it starts on demand.
# Defaults to %LOCALAPPDATA%\pgsql17 on Windows.
# AA_PG_HOME=

# ── At handoff: the firm's connectors ─────────────────────────────────────────────
#
# Box is where the work arrives: the client uploads to ShareFile, the files move to Box,
# and this reads Box. So Box is on the *storage* side, and it is a real adapter rather
# than a contract - though nothing in this repo has spoken to a real tenant, so the first
# proof is the connection test on the machine that has the credentials.
#
# The three that work. BOX_USER_ID is the person whose folders are read: the token is a
# client-credentials grant with user impersonation, and the Box app must have "Generate
# User Access Tokens" enabled or Box refuses it. Without the impersonation the token
# authenticates as the service account, which is a member of almost nothing - so a sweep
# would return an empty folder rather than an error, and an unauthorised sweep and an
# empty one would be indistinguishable.
#
# AA_STORAGE_ADAPTER=box
# BOX_CLIENT_ID=
# BOX_CLIENT_SECRET=
# BOX_USER_ID=
# AA_BOX_INBOX_FOLDER_ID=
#
# Deliverables are written to a different Box folder than work is read from. One setting
# for both is how a deliverable lands in a client's inbox.
#
# AA_DELIVERY_ADAPTER=box
# AA_BOX_ROOT_FOLDER_ID=
#
# ShareFile, which these three do not finish. An account with MFA cannot use a password
# grant, so nothing here can sign in: a person presses Sign in on the Setup page once,
# authenticates in a browser, and everything after runs on a refresh token that ShareFile
# renews. The Setup page reports three different things - nobody has signed in, somebody
# did and the token no longer works, and connected.
#
# The app registration needs the callback this server will actually receive on,
# http://127.0.0.1:8000/api/admin/sharefile/callback, and it has to ask for offline
# access - without that the login lasts an hour and then stops.
#
# AA_STORAGE_ADAPTER=sharefile
# SHAREFILE_SUBDOMAIN=
# SHAREFILE_CLIENT_ID=
# SHAREFILE_CLIENT_SECRET=
# AA_SHAREFILE_ROOT=

# The refresh token a login leaves behind. Encrypted under a key derived from
# AA_VAULT_KEY and written where .gitignore already reaches, so it is never committed and
# never sits in plain text. Delete the file to force a fresh sign-in.
# AA_TOKEN_STORE=vault/refresh-tokens.enc

# A rehearsal, not analysis. `AA_LLM_ADAPTER=scripted` answers every skill from the
# request so a run walks the whole loop - review queue, decisions, precedent - with no
# key and no spend. It refuses to build unless this is set beside it, so it can never
# stand in for a model by accident. `python tools/simulate_firm.py --scripted` sets both.
# AA_REHEARSAL=1

# Set by `tools/gate.py` on the processes it starts, and by nobody else. A phase may name
# `tools/verify.py` as a check; verify runs the whole suite; the suite runs `gate check` on
# the first open phase - which is the gate, running the same checks, inside itself. Each
# turn is a full suite and the machine stops finishing any of them. A nested gate sees this
# and declines to re-run the checks. Setting it by hand would make `gate close` pass
# without running anything, which is the one thing the gate exists to prevent.
# AA_GATE_RUNNING=
