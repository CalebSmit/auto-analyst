# Copy to .env and fill in. .env is gitignored and never leaves this machine.
# At handoff to the work machine, only ANTHROPIC_API_KEY changes.

ANTHROPIC_API_KEY=sk-ant-...

# Deployment mode: local | work | cloud
AA_MODE=local

# Ports - local adapters for phases 1-24
AA_STORAGE_ADAPTER=local_folder
AA_DELIVERY_ADAPTER=local_folder
AA_SECRETS_ADAPTER=dotenv
AA_QUEUE_ADAPTER=in_process
AA_COMPUTE_ADAPTER=local_process

# The fake LLM adapter replays recorded fixtures, so phases 4-10 need no API key and
# cost nothing to run. Switch to anthropic_messages when a run means to reach a model.
AA_LLM_ADAPTER=fake

# State store. The run store is a repository behind this one URL: SQLite locally
# through P24, Postgres after, with no other change. runs/ is gitignored - the record
# holds client data. This is also the default when nothing is set.
AA_DB_URL=sqlite:///./runs/run_store.db

# Where `pytest --postgres` looks for a server, when there is one. Nothing else reads
# it, and the suite is red rather than skipped if --postgres is asked for and no server
# answers.
# AA_TEST_PG_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analyst_test

# The mask vault's encryption key. The vault is the only store that can re-identify
# anything, and this key is the only thing that opens it. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and never commit it. Losing it loses every token it protects.
AA_VAULT_KEY=
# Retention for vault entries, in days. A placeholder: setting the policy is Risk / IT's
# decision in the blueprint, before phase 1.
# AA_VAULT_RETENTION_DAYS=730

# Intake and delivery roots (local mode only)
AA_INBOX_ROOT=./inbox
AA_OUTBOX_ROOT=./outbox

# Compute target (optional). Parallelism is cross-engagement - the Engagement Lock
# already serialises within one deal, and the worker pool asks this port how wide it may
# be rather than assuming.
# AA_MAX_PARALLELISM=1
# AA_IMAGE=automated-analyst:0.1.0
# Scratch space for a run. Never inside the repo: run artifacts hold client data.
# Defaults to the system temp directory.
# AA_WORKDIR=

# The job queue. in_process runs a bounded thread pool in this process; redis_rq runs
# over a broker, for when runs outlive the process that submitted them.
# AA_REDIS_URL=redis://localhost:6379/0
# AA_REDIS_QUEUE=automated-analyst
# Where `pytest --redis` looks for a real server. Without it the queue suite runs the
# adapter over an in-memory fake and says so in the session summary.
# AA_TEST_REDIS_URL=redis://localhost:6379/15

# The governance chain's working root: the drop folder, triage, the sandbox and the
# append-only governance record. Outside the repo, always - a dropped draft is untrusted
# content and the scan that catches a pasted trial balance runs after the drop.
# Defaults to ~/.automated-analyst/skills-intake
# AA_SKILLS_INTAKE_ROOT=

# Where tools/postgres.py keeps the portable PostgreSQL binaries it starts on demand.
# Defaults to %LOCALAPPDATA%\pgsql17 on Windows.
# AA_PG_HOME=

# ── At handoff: the firm's connectors ─────────────────────────────────────────────
#
# Two adapters are registered as port contracts with no implementation in this repo:
# ShareFile on the storage port and Box on the delivery port. Selecting one before its
# connector is wired in refuses with SCOPE.ADAPTER_NOT_WIRED rather than falling back to
# the local folder - a run reading from, or writing to, somewhere nobody chose is the
# failure the ports exist to prevent. See HANDOFF.md.
#
# AA_STORAGE_ADAPTER=sharefile
# SHAREFILE_SUBDOMAIN=
# SHAREFILE_CLIENT_ID=
# SHAREFILE_CLIENT_SECRET=
# AA_SHAREFILE_ROOT=
#
# AA_DELIVERY_ADAPTER=box
# BOX_CLIENT_ID=
# BOX_CLIENT_SECRET=
# BOX_ENTERPRISE_ID=
# AA_BOX_ROOT_FOLDER_ID=
