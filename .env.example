# Copy to .env and fill in. .env is gitignored and never leaves this machine.
# At handoff to the work machine, only ANTHROPIC_API_KEY changes.

ANTHROPIC_API_KEY=sk-ant-...

# Deployment mode: local | work | cloud
AA_MODE=local

# Ports - local adapters for phases 1-24
AA_STORAGE_ADAPTER=local_folder
AA_DELIVERY_ADAPTER=local_folder
AA_SECRETS_ADAPTER=dotenv
AA_QUEUE_ADAPTER=in_process
AA_COMPUTE_ADAPTER=local_process

# The fake LLM adapter replays recorded fixtures, so phases 4-10 need no API key and
# cost nothing to run. Switch to anthropic_messages when a run means to reach a model.
AA_LLM_ADAPTER=fake

# State store. The run store is a repository behind this one URL: SQLite locally
# through P24, Postgres after, with no other change. runs/ is gitignored - the record
# holds client data. This is also the default when nothing is set.
AA_DB_URL=sqlite:///./runs/run_store.db

# Where `pytest --postgres` looks for a server, when there is one. Nothing else reads
# it, and the suite is red rather than skipped if --postgres is asked for and no server
# answers.
# AA_TEST_PG_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analyst_test

# Intake and delivery roots (local mode only)
AA_INBOX_ROOT=./inbox
AA_OUTBOX_ROOT=./outbox

# Compute target (optional). Parallelism is cross-engagement - the Engagement Lock
# already serialises within one deal.
# AA_MAX_PARALLELISM=1
# AA_IMAGE=automated-analyst:0.1.0
