{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartwell.invalid/contracts/skills/model-load@1.0.0",
  "title": "Model load and assembly output",
  "description": "A mapping the Template Writer executes. This skill writes no cells and originates no figures - it routes validated upstream figures to named ranges, and names everything it could not route.",
  "x-skill": "model-load",
  "x-emits-figures": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "produced_by",
    "template_mapping"
  ],
  "properties": {
    "schema_version": {
      "const": "skills/model-load@1.0.0"
    },
    "produced_by": {
      "type": "string",
      "pattern": "^model[-]load@[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "template_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_version",
        "bindings",
        "unmapped_template_inputs",
        "unrouted_upstream_figures"
      ],
      "properties": {
        "template_version": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "named_range",
              "source_output",
              "figure_ref"
            ],
            "properties": {
              "named_range": {
                "type": "string",
                "pattern": "^(?![A-Za-z]{1,3}[0-9]+$)[A-Za-z_][A-Za-z0-9_.]*$",
                "description": "A named range or Excel Table reference. The pattern rejects a cell address outright: B44 is not a contract, and one inserted row would shift every mapping below it into a plausibly wrong deliverable."
              },
              "source_output": {
                "type": "string",
                "minLength": 1
              },
              "figure_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unmapped_template_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "named_range",
              "why"
            ],
            "properties": {
              "named_range": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "A required template input with no source. Listed, so two empty cells are not discovered by the client."
        },
        "unrouted_upstream_figures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "figure_ref",
              "why"
            ],
            "properties": {
              "figure_ref": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
