{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartwell.invalid/contracts/skills/line-item-tagging@1.0.0",
  "title": "Line-item tagging output",
  "description": "A category and the two inclusion flags per line item, with a rationale and the precedent it drew on. This skill categorises; it originates no numbers, which is why it has no field a figure can enter through.",
  "x-skill": "line-item-tagging",
  "x-emits-figures": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "produced_by",
    "tagged_line_items"
  ],
  "properties": {
    "schema_version": {
      "const": "skills/line-item-tagging@1.0.0"
    },
    "produced_by": {
      "type": "string",
      "pattern": "^line[-]item[-]tagging@[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "tagged_line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_item_ref",
          "description",
          "category",
          "excluded_from_al",
          "include_in_nwc",
          "confidence",
          "rationale",
          "review_required"
        ],
        "properties": {
          "line_item_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Stable reference to a line item in the normalized historicals."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "excluded_from_al": {
            "type": "boolean"
          },
          "include_in_nwc": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "precedent_ref": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "taxonomy_version": {
            "type": "string",
            "minLength": 1
          },
          "review_required": {
            "type": "boolean"
          },
          "uncategorisable": {
            "type": "boolean",
            "description": "The description is too sparse to categorise. Set this rather than guessing from the amount."
          }
        }
      }
    }
  }
}
